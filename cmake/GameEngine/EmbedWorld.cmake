# Embeds the world in the game binary, so each game carries its own world:
#   cmake -DINPUT=<world.obe> -DOUTPUT=<GameWorld.cpp> -P EmbedWorld.cmake
# OUTPUT defines client::gameWorld() (include/GameEngine/client/GameWorld.hpp) with the bytes of INPUT.
# It is only rewritten when the world changed, and kept as is when INPUT is gone (e.g. /tmp was cleared).

if(NOT EXISTS "${INPUT}")
    if(EXISTS "${OUTPUT}")
        message(STATUS "No world at ${INPUT}, keeping the embedded one")
        return()
    endif()
    message(WARNING "No world at ${INPUT}: the game has no world, compile it from the engine")
    set(size 0)
    set(bytes "")
else()
    file(SIZE "${INPUT}" size)
    file(READ "${INPUT}" bytes HEX)
endif()

# 16 bytes per line, then a trailing 0 keeps the array non-empty when there is no world
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 row)
string(REGEX REPLACE "(${row})" "\\1\n    " bytes "${bytes}")
math(EXPR length "${size} + 1")

string(CONFIGURE [=[
// Generated by cmake/GameEngine/EmbedWorld.cmake, do not edit

#include "GameEngine/client/GameWorld.hpp"
#include <array>

namespace {

constexpr std::array<unsigned char, @length@> WORLD{
    @bytes@0x00
};

} // namespace

std::string_view client::gameWorld()
{
    return {reinterpret_cast<const char *>(WORLD.data()), @size@};
}
]=] content @ONLY)

if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
